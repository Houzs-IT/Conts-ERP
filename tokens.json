  "motion": {
    "fast": {
      "duration": "120ms",
      "easing": "cubic-bezier(0.16,1,0.3,1)",
      "use": "hover, pressed, colour transitions"
    },
    "standard": {
      "duration": "200ms",
      "easing": "cubic-bezier(0.16,1,0.3,1)",
      "use": "menus, drawers, submenu expand, toasts"
    },
    "slow": {
      "duration": "240ms",
      "easing": "cubic-bezier(0.16,1,0.3,1)",
      "use": "dialogs"
    },
    "keyframes": [
      "rise",
      "fade-in",
      "draw",
      "dialog-in",
      "toast-in",
      "grow",
      "spin",
      "pulse-soft",
      "shimmer"
    ],
    "rules": [
      "prefers-reduced-motion disables all animation.",
      "No decorative looping. The only permitted loop is the live-connection dot.",
      "Never animate a financial value in a way that delays reading or implies false live activity.",
      "Sequenced entrances are authored once on the auth stage, not repeated across the app."
    ]
