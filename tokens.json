  "semantic": {
    "$note": "Tint background + -fg for text + -line for non-text. See $accessibilityCorrection.",
    "$accessibilityCorrection": {
      "reason": "The brand guide §4.2 base values fail WCAG AA as 11px badge text on their own tints, while §4.3 requires AA for body text and interactive controls. Status badges are 11px labels in dense operational tables, so the 3:1 large-text allowance does not apply.",
      "action": "Guide hexes retained as -line (non-text use). -fg darkened until measured >= 4.5:1 on the tint.",
      "takeToClient": true,
      "failingGuideValues": [
        {
          "state": "success",
          "guide": "#16845B",
          "onTint": "4.18:1"
        },
        {
          "state": "warning",
          "guide": "#B7791F",
          "onTint": "3.32:1"
        },
        {
          "state": "critical",
          "guide": "#C2413B",
          "onTint": "4.45:1"
        }
      ]
    },
    "success": {
      "bg": "#E9F5EF",
      "fg": "#11694A",
      "line": "#16845B",
      "solid": "#11694A",
      "ratioOnTint": "5.97:1",
      "ratioOnWhite": "6.68:1",
      "meaning": "Completed, healthy, available",
      "states": [
        "Ready",
        "Resolved",
        "Checked in",
        "Paid"
      ]
    },
    "warning": {
      "bg": "#FFF4D8",
      "fg": "#8A5A12",
      "line": "#B7791F",
      "ratioOnTint": "5.40:1",
      "ratioOnWhite": "5.91:1",
      "meaning": "Attention without immediate failure",
      "states": [
        "Dirty",
        "Inspection",
        "Waiting",
        "Pending",
        "Not sent"
      ]
    },
    "critical": {
      "bg": "#FCECEB",
      "fg": "#A8352F",
      "line": "#C2413B",
      "solid": "#A8352F",
      "solidHover": "#8F2C27",
      "ratioOnTint": "5.70:1",
      "ratioOnWhite": "6.53:1",
      "meaning": "Safety, failure, overdue escalation",
      "states": [
        "Overdue",
        "Maintenance",
        "Reopened",
        "No show",
        "Failed"
      ]
    },
    "info": {
      "bg": "#EAF2FA",
      "fg": "#2E6DA4",
      "line": "#2E6DA4",
      "ratioOnTint": "4.83:1",
      "ratioOnWhite": "5.46:1",
      "unchangedFromGuide": true,
      "meaning": "Neutral system information",
      "states": [
        "Confirmed",
        "Occupied",
        "Cleaning",
        "Assigned",
        "In progress"
      ]
    },
    "neutral": {
      "bg": "#F1F0ED",
      "fg": "#706D67",
      "line": "#C7C1B6",
      "ratioOnTint": "4.52:1",
      "ratioOnWhite": "5.15:1",
      "unchangedFromGuide": true,
      "meaning": "Draft, inactive, unknown",
      "states": [
        "Inquiry",
        "Checked out",
        "Blocked",
        "Open",
        "Provisional"
      ]
    }
  },
