  "auth": {
    "routes": [
      {
        "path": "/login",
        "component": "LoginPage",
        "public": true,
        "status": "designed",
        "submit": {
          "label": "Sign in",
          "api": "POST /api/auth/login",
          "body": [
            "email",
            "password"
          ],
          "onSuccess": [
            {
              "when": "must_change_password === true",
              "goto": "/change-password"
            },
            {
              "when": "role in [housekeeper, technician]",
              "goto": "/field/today"
            },
            {
              "when": "role === owner",
              "goto": "/owner"
            },
            {
              "when": "default",
              "goto": "/"
            }
          ],
          "onError": {
            "status": 401,
            "render": "inline error block",
            "copy": "Invalid email or password. Five failed attempts lock the account for 15 minutes."
          },
          "onLockout": {
            "status": 423,
            "copy": "Account locked for 15 minutes after five failed attempts. Try again at {unlockAt} or ask an administrator to reset it."
          },
          "note": "No portal picker. One sign-in for every role: the response's user.role decides the landing screen. An owner signing in reaches the owner portal without choosing it, and staff never see owner-portal chrome."
        },
        "links": [
          {
            "label": "Forgot password?",
            "goto": "/forgot-password"
          }
        ]
      },
      {
        "path": "/forgot-password",
        "component": "ForgotPasswordPage",
        "public": true,
        "status": "designed",
        "submit": {
          "label": "Send reset link",
          "api": "POST /api/auth/forgot-password",
          "body": [
            "email"
          ],
          "onSuccess": {
            "render": "success block",
            "copy": "If that email belongs to a Conts ERP account, a reset link is on its way. The link expires in 60 minutes.",
            "note": "Always the same response — never disclose whether an account exists."
          }
        },
        "links": [
          {
            "label": "Back to sign in",
            "goto": "/login"
          }
        ]
      },
      {
        "path": "/reset-password",
        "component": "ResetPasswordPage",
        "public": true,
        "query": [
          "token"
        ],
        "status": "not_designed",
        "submit": {
          "label": "Save and sign in",
          "api": "POST /api/auth/reset-password",
          "body": [
            "token",
            "password"
          ]
        }
      },
      {
        "path": "/change-password",
        "component": "ChangePasswordPage",
        "public": false,
        "status": "designed",
        "note": "Forced when users.must_change_password is true. No other route is reachable until satisfied.",
        "submit": {
          "label": "Save and continue",
          "api": "POST /api/auth/change-password",
          "body": [
            "password"
          ],
          "onSuccess": {
            "goto": "role home"
          }
        }
      },
      {
        "path": "/logout",
        "api": "POST /api/auth/logout",
        "onSuccess": {
          "goto": "/login"
        }
      }
    ],
    "passwordPolicy": {
      "minLength": 8,
      "requireUppercase": 1,
      "requireDigit": 1,
      "validateOn": "change (live checklist) + submit",
      "copy": [
        "At least 8 characters",
        "At least 1 uppercase letter",
        "At least 1 digit"
      ]
    },
    "session": {
      "strategy": "httpOnly cookie",
      "inactivityTimeout": "8h",
      "absoluteTimeout": "30d",
      "states": [
        "connected",
        "expired",
        "degraded",
        "failed"
      ]
    },
    "lockout": {
      "maxAttempts": 5,
      "windowMinutes": 15
    },
    "portalSelection": {
      "decision": "Rejected",
      "rationale": "A portal picker asks the user to answer what the server already knows, leaks internal structure to owners, and adds a step to the most-used screen in the product. The role on the account is authoritative.",
      "implementation": "POST /api/auth/login returns user.role and a resolved home path. The client redirects; it never branches on a user choice."
    }
  },
