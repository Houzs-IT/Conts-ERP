{
  "$meta": {
    "product": "Conts ERP",
    "source": "The Conts Digital Brand Guide v1.0 — sections 13, 14, 15, 16",
    "note": "Route map shared by frontend router, backend permission middleware and QA. Navigation is organised by job, never by database table (13.1).",
    "apps": {
      "staff": {
        "basePath": "/",
        "shell": "AppShell",
        "nav": "sidebar 240px / collapsed 72px"
      },
      "owner": {
        "basePath": "/owner",
        "shell": "OwnerShell",
        "nav": "top bar, lower density (15)"
      },
      "field": {
        "basePath": "/field",
        "shell": "FieldShell",
        "nav": "bottom bar, 44px targets (16.1)"
      },
      "mobile": {
        "basePath": "/m",
        "shell": "MobileShell",
        "nav": "bottom bar, 44px targets",
        "file": "The Conts Mobile.dc.html",
        "note": "Owner portal only, capped to 430px. Bottom navigation: Statement, Bookings, My units. Staff run the desktop; a field-crew app is a later phase."
      }
    },
    "structure": {
      "rule": "Two products, not many pages. Every module lives inside the desktop app or the mobile app.",
      "files": {
        "The Conts Desktop.dc.html": "Desktop product: sign-in plus every staff module behind the sidebar.",
        "The Conts Mobile.dc.html": "Mobile product: sign-in plus role-aware screens behind bottom navigation.",
        "The Conts Design System.dc.html": "Visual reference, not a product surface.",
        "The Conts Frontend Spec.dc.html": "Printable handoff document."
      }
    }
  },
  "roles": {
    "management": {
      "label": "Management",
      "scope": "All modules, read + approve",
