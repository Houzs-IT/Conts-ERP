{
  "name": "theconts-property-os",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite build && wrangler pages dev --port 8788",
    "dev:vite": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/migrate-pg.mjs",
    "db:migrate:dry": "node scripts/migrate-pg.mjs --dry-run",
    "deploy": "npm run build && wrangler pages deploy dist --branch theconts-os",
    "setup": "node scripts/setup.mjs",
    "deploy:cron": "wrangler deploy --config wrangler.cron.toml"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "clsx": "^2.1.1",
    "lucide-react": "^0.477.0",
    "postgres": "^3.4.9",
    "qrcode-generator": "1.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260929.1",
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "wrangler": "^4.148.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260926.1": true,
    "sharp@0.33.5": true
  },
  "overrides": {
    "sharp": "^0.35.5"
  }
}
