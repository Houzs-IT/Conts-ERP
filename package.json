{
  "name": "theconts-property-os",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite build && wrangler pages dev --port 8788",
    "dev:vite": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply theconts-prod --local",
    "db:seed:local": "wrangler d1 execute theconts-prod --local --file=./scripts/seed-d1.sql",
    "db:migrate": "wrangler d1 migrations apply theconts-prod --remote",
    "deploy": "npm run build && wrangler pages deploy dist --branch theconts-os",
    "db:seed:staging": "wrangler d1 execute theconts-staging --remote --file=./scripts/seed-d1.sql",
    "setup": "node scripts/setup.mjs",
    "deploy:cron": "wrangler deploy --config wrangler.cron.toml"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "lucide-react": "^0.477.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "wrangler": "^3.99.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.17.19": true,
    "workerd@1.20250718.0": true,
    "sharp@0.33.5": true
  }
}
