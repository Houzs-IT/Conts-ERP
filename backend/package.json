{
  "name": "conts-erp-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env staging",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "db:migrate": "node scripts/migrate.mjs",
    "db:migrate:dry": "node scripts/migrate.mjs --dry-run",
    "seed:owner": "node scripts/seed-owner.mjs"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "jose": "^5.9.6",
    "postgres": "^3.4.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260917.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "^4.112.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260917.1": true
  }
}
