# Copy to .dev.vars for local development. Never commit .dev.vars. This is the only env file.
SESSION_SECRET="replace-with-a-long-random-string"
TOTP_ENC_KEY=

# npm run dev:staging / npm run dev (scripts/dev.mjs) read these from the same file.

DATABASE_URL_STAGING=
DATABASE_URL_PRODUCTION=
SUPABASE_SERVICE_ROLE_KEY_STAGING=
SUPABASE_SERVICE_ROLE_KEY_PRODUCTION=

# Houzs Connect guest-messaging push (functions/_lib/connect.ts). Leave CONNECT_WEBHOOK_KEY empty to
# keep the feature inert locally (nothing is sent). The URL defaults to prod in code if unset.
CONNECT_WEBHOOK_URL=https://chat.houzscentury.com
CONNECT_WEBHOOK_KEY=
# Optional: automation names operators may pick (JSON array or comma-separated), e.g.
# CONNECT_AUTOMATIONS=Check-in Instructions,Pre-arrival,Checkout Reminder
CONNECT_AUTOMATIONS=
